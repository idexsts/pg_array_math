--большое количество элементов
SELECT cardinality(
    array_add(
        ARRAY(SELECT generate_series(1, 2000000)::bigint),
        ARRAY(SELECT generate_series(1, 2000000)::bigint)
    )
);
 cardinality 
-------------
     2000000
(1 row)

SELECT cardinality(
    array_add(
        ARRAY(SELECT generate_series(1, 5000000)),
        ARRAY(SELECT generate_series(1, 5000000))
    )
);
 cardinality 
-------------
